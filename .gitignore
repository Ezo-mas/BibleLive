backend/bible_data/*.sqlite.*

# Test artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.vitest/
*.test.js
*.test.jsx

# OS
.DS_Store
Thumbs.db

# Environment variables (keep .env.example, not .env)
.env

# Logs
*.log

# Frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
static/frontend/

# Temporary files
*.tmp
tmp/

# Claude Code: share agents, settings, hooks, skills and rules; keep personal
# settings (settings.local.json) and worktrees local
.claude/*
!.claude/agents/
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
!.claude/rules/

# Runtime server settings (written by the server, e.g. the auto-approve mode)
data/server_settings.json
# The operator's idle-screen picture, kept beside the settings file (and its temp files)
data/idle_screen.png
data/idle_screen.jpg
data/idle_screen.webp
data/.idle_screen.*.tmp

# Benchmark inputs/outputs. Sermon audio is large and not ours to redistribute;
# result JSONs and the STT cache embed full transcripts and are regenerated by
# benchmarks/run_benchmark.py. Manifests and gold annotations stay tracked.
/bench_audio/
/bench_audio.bench-16k/
/results/
