# BibleLive Environment Configuration
# Copy this file to .env and customize for your environment

# Server Configuration
BIBLELIVE_HOST=0.0.0.0
BIBLELIVE_PORT=8000

# Auto-reload (development only - set to false in production)
BIBLELIVE_RELOAD=false

# Logging
BIBLELIVE_LOG_LEVEL=INFO

# Database Configuration
BIBLELIVE_DB_PATH=bible_data/biblelive.sqlite
BIBLELIVE_DB_READONLY=true

# Bible Data Sources
BIBLELIVE_KJV_JSON_PATH=data/kjv2.json

# Auto-approve mode: off | high | medium_and_up | all
# Bootstrap default only: a mode chosen in the operator console is persisted and
# takes precedence over this value. An invalid value means 'off'.
BIBLELIVE_AUTO_MODE=off

# Where the server persists operator settings (the auto-approve mode). Written
# atomically; kept outside bible_data/, which stays read-only.
BIBLELIVE_SETTINGS_PATH=data/server_settings.json

# Bible version switching. Translations are the *.sqlite files (with a
# `translation` metadata row) next to BIBLELIVE_DB_PATH. When the spoken language
# is switched, the server also selects that language's default translation.
BIBLELIVE_AUTO_BIBLE_VERSION=true
# BIBLELIVE_LANGUAGE_BIBLE_VERSIONS={"en":"kjv","lt":"ltb"}

# Follow-along: suggest the next verses to the operator as the speaker reads on.
BIBLELIVE_FOLLOW_ALONG=true

# Audio Pipeline Configuration
# Model/device/language/VAD are CLI flags on `python3 -m audio.cli`, e.g.
#   python3 -m audio.cli --model small --device cuda --compute-type float16 --language en
# Only the log level is read from the environment:
# BIBLELIVE_AUDIO_LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
# (DEBUG additionally traces ffmpeg output, ignored VAD blips and dedup skips)

# API Base URL (for audio pipeline to connect to server)
# BIBLELIVE_API_URL=http://localhost:8000

# ========================================
# AUTHENTICATION (IMPORTANT FOR PRODUCTION)
# ========================================

# Enable authentication for operator controls (approve, clear, etc.)
# Set to true in production to protect operator endpoints
BIBLELIVE_REQUIRE_AUTH=false

# Operator access token - required if REQUIRE_AUTH=true. The audio pipeline
# reads it from here too and sends it with every detected reference.
# Generate a secure token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# BIBLELIVE_OPERATOR_TOKEN=your-secure-random-token-here

# ========================================
# CORS CONFIGURATION
# ========================================

# Comma-separated list of allowed origins for cross-origin requests
# Leave empty for same-origin only (recommended if frontend served by same server)
# Examples:
#   Development: BIBLELIVE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#   Production: BIBLELIVE_CORS_ORIGINS=https://yourdomain.com
#   All origins (DEV ONLY): BIBLELIVE_CORS_ORIGINS=*
BIBLELIVE_CORS_ORIGINS=

# ========================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ========================================
# 1. Set BIBLELIVE_REQUIRE_AUTH=true
# 2. Generate and set a strong BIBLELIVE_OPERATOR_TOKEN
# 3. Set BIBLELIVE_RELOAD=false
# 4. Configure CORS origins if needed
# 5. Use reverse proxy (nginx/caddy/traefik) with TLS for HTTPS/WSS
# 6. Set BIBLELIVE_HOST=127.0.0.1 if behind reverse proxy on same machine
# 7. Ensure Bible database is imported and verified
# 8. Build frontend: cd frontend && npm install && npm run build
#
# Repository layout note: Python packages live in backend/ and are imported as
# core.* / audio.*. Set PYTHONPATH when running modules from the repo root:
#   export PYTHONPATH="$PWD/backend"    # start.sh and the Makefile do this
# 9. Test health endpoints: /healthz and /readyz

