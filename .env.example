# BibleLive Environment Configuration
# Copy this file to .env and customize for your environment

# Server Configuration
BIBLELIVE_HOST=0.0.0.0
BIBLELIVE_PORT=8000

# Auto-reload (development only - set to false in production)
BIBLELIVE_RELOAD=false

# Logging
BIBLELIVE_LOG_LEVEL=INFO

# Database Configuration
BIBLELIVE_DB_PATH=bible_data/biblelive.sqlite
BIBLELIVE_DB_READONLY=false

# Bible Data Sources
BIBLELIVE_KJV_JSON_PATH=data/kjv.json

# Audio Pipeline Configuration (optional overrides)
# BIBLELIVE_AUDIO_DEVICE=default
# BIBLELIVE_AUDIO_SAMPLE_RATE=16000
# BIBLELIVE_TRANSCRIPTION_MODEL=base

# API Base URL (for audio pipeline to connect to server)
# BIBLELIVE_API_URL=http://localhost:8000

# ========================================
# AUTHENTICATION (IMPORTANT FOR PRODUCTION)
# ========================================

# Enable authentication for operator controls (approve, clear, etc.)
# Set to true in production to protect operator endpoints
BIBLELIVE_REQUIRE_AUTH=false

# Operator access token - required if REQUIRE_AUTH=true
# Generate a secure token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# BIBLELIVE_OPERATOR_TOKEN=your-secure-random-token-here

# ========================================
# CORS CONFIGURATION
# ========================================

# Comma-separated list of allowed origins for cross-origin requests
# Leave empty for same-origin only (recommended if frontend served by same server)
# Examples:
#   Development: BIBLELIVE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#   Production: BIBLELIVE_CORS_ORIGINS=https://yourdomain.com
#   All origins (DEV ONLY): BIBLELIVE_CORS_ORIGINS=*
BIBLELIVE_CORS_ORIGINS=

# ========================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ========================================
# 1. Set BIBLELIVE_REQUIRE_AUTH=true
# 2. Generate and set a strong BIBLELIVE_OPERATOR_TOKEN
# 3. Set BIBLELIVE_RELOAD=false
# 4. Configure CORS origins if needed
# 5. Use reverse proxy (nginx/caddy/traefik) with TLS for HTTPS/WSS
# 6. Set BIBLELIVE_HOST=127.0.0.1 if behind reverse proxy on same machine
# 7. Ensure Bible database is imported and verified
# 8. Build frontend: cd frontend && npm install && npm run build
# 9. Test health endpoints: /healthz and /readyz

