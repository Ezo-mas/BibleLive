{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Edit(/static/frontend/**)",
      "Edit(/bench_audio/**)"
    ],
    "ask": [
      "Edit(/bible_data/**)",
      "Edit(/backend/core/server/models.py)",
      "Edit(/frontend/src/shared/types.ts)",
      "Bash(npm run build*)",
      "Bash(make frontend-build*)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format_file.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
