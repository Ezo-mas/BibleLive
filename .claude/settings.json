{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "frontend-design@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": false,
    "code-simplifier@anthropic-plugin-directory": false,
    "playwright@anthropic-plugin-directory": false
  },
  "skillOverrides": {
    "claude-api": "off",
    "plugin-authoring": "off",
    "dataviz": "name-only"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Edit(/static/frontend/**)",
      "Edit(/bench_audio/**)"
    ],
    "ask": [
      "Edit(/bible_data/**)",
      "Edit(/backend/core/server/models.py)",
      "Edit(/frontend/src/shared/types.ts)",
      "Bash(npm run build*)",
      "Bash(make frontend-build*)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format_file.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
